@startuml
title Engineer Quest - Course・Mission・Activity構成

skinparam componentStyle rectangle
skinparam linetype ortho

actor "学習者" as Learner

node "Next.js Frontend" {
  component "App Router\n薄いpage.tsx" as RouteEntry
  component "MissionActivityPlayPage\n回答・進捗オーケストレーション" as PlayFeature
  component "Activity Renderer Registry" as FrontRegistry
  component "Problem Type Inputs" as Inputs
  component "Algorithm Visualizations" as Visualizations
  component "Shared Activity Components" as SharedComponents
  component "Course Mission Python Editor" as CourseEditor
}

node "Express Backend" {
  component "Mission Router / Controller" as MissionHttp
  component "Mission Service" as MissionService
  component "ActivityContent Schema / Registry" as BackRegistry
  component "Course Router / Controller / Service" as CourseModule
  component "Prisma Client" as Prisma
}

database "PostgreSQL" as Postgres

Learner --> RouteEntry
RouteEntry --> PlayFeature
PlayFeature --> FrontRegistry : rendererKeyを解決
PlayFeature --> Inputs : 回答UIを表示
PlayFeature --> Visualizations : 教材可視化を表示
PlayFeature --> SharedComponents : Shell・配列・feedback
PlayFeature --> CourseEditor : Course Mission時のみ
PlayFeature --> MissionHttp : REST API

MissionHttp --> MissionService
MissionService --> BackRegistry : data検証・採点方式
MissionService --> Prisma
CourseModule --> Prisma
Prisma --> Postgres

note bottom of FrontRegistry
  Course IDやMission番号ではなく、
  rendererKeyと問題型で表示を選ぶ。
end note

note bottom of BackRegistry
  seed・API・採点が同じ登録表と
  Zod schemaを参照する。
end note

@enduml
