@startuml
title Course・Mission学習API ルート一覧

left to right direction
skinparam packageStyle rectangle

actor "Mission Activity画面" as Frontend

package "/api/courses" {
  usecase "GET /\n公開Course一覧と進捗" as CoursesList
  usecase "GET /{courseId}\nCourseロードマップ" as CourseRoadmap
}

package "/api/missions" {
  usecase "GET /{missionId}/overview\nMission概要" as MissionOverview
  usecase "GET /{missionId}/play\nActivity一覧と進捗" as MissionPlay
  usecase "POST /{missionId}/activities/{activityId}/answer\n回答・採点・回答ログ" as ActivityAnswer
  usecase "POST /{missionId}/activities/{activityId}/complete\nActivity完了" as ActivityComplete
  usecase "POST /{missionId}/complete\nMission完了・報酬" as MissionComplete
  usecase "GET・POST /{missionId}/course-exam/attempt*\nCourse Mission試行・ヒント・テスト実行" as CourseExamAttempt
}

Frontend --> CoursesList
Frontend --> CourseRoadmap
Frontend --> MissionOverview
Frontend --> MissionPlay
Frontend --> ActivityAnswer
Frontend --> ActivityComplete
Frontend --> MissionComplete
Frontend --> CourseExamAttempt

note bottom
  すべてFirebase token検証を通る。
  旧 /lesson/* と /exam/* は現在のExpress routerには存在しない。
end note

@enduml
