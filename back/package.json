{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"No tests yet\"",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node --files src/app.ts\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "validate:learning-seed": "ts-node src/scripts/validateLearningSeed.ts",
    "verify:course-mission-code": "ts-node src/scripts/verifyCourseMissionAnswerCode.ts",
    "verify:bfs-course": "ts-node src/scripts/verifyBreadthFirstSearchCourse.ts",
    "verify:dfs-course": "ts-node src/scripts/verifyDepthFirstSearchCourse.ts",
    "verify:merge-course": "ts-node src/scripts/verifyMergeSortCourse.ts",
    "verify:selection-course": "ts-node src/scripts/verifySelectionSortCourse.ts",
    "verify:static": "npm run validate:learning-seed && npm run verify:bfs-course && npm run verify:dfs-course && npm run verify:merge-course && npm run verify:course-mission-code && npm run verify:create-quests && npm run verify:collections && npm run verify:feedback-prompts && npm run verify:feedback-v1 && npm run verify:seed-preservation",
    "verify:learning-db": "ts-node src/scripts/verifySeededLearningData.ts",
    "reset:learning-course": "ts-node src/scripts/resetCourseLearningState.ts",
    "test:e2e:learning": "ts-node src/scripts/e2eLearningFlow.ts",
    "preview:feedback-prompts": "ts-node src/scripts/previewCourseExamFeedbackPrompts.ts",
    "verify:feedback-prompts": "ts-node src/scripts/verifyCourseExamFeedbackPrompts.ts",
    "verify:create-quests": "ts-node src/scripts/verifyCreateQuestReferenceSolutions.ts",
    "verify:collections": "ts-node src/scripts/verifyCollectionMasterData.ts",
    "verify:collections-db": "ts-node src/scripts/verifyCollectionDatabase.ts",
    "test:e2e:collections": "ts-node src/scripts/e2eCollectionRewards.ts",
    "test:e2e:create-achievements": "ts-node src/scripts/e2eCreateQuestAchievements.ts",
    "start": "node dist/src/app.js",
    "lint": "eslint src --ext .ts",
    "verify:feedback-v1": "ts-node src/scripts/verifyFeedbackV1.ts",
    "verify:feedback-v1-storage": "ts-node src/scripts/verifyFeedbackV1Storage.ts",
    "verify:feedback-v1-context": "ts-node src/scripts/verifyFeedbackV1Context.ts",
    "seed:preserve": "ts-node prisma/seed.ts --preserve-existing",
    "verify:seed-preservation": "ts-node src/scripts/verifyPreservingSeed.ts",
    "verify:master-db": "ts-node src/scripts/verifySeededMasterData.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@google/genai": "^1.16.0",
    "@prisma/client": "^5.22.0",
    "@typescript-eslint/typescript-estree": "^8.47.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0",
    "just-diff": "^6.0.2",
    "openai": "^6.15.0",
    "puppeteer": "^24.31.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "eslint": "^10.2.0",
    "nodemon": "^3.1.10",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.2"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  }
}
