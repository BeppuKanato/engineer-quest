{
  "name": "backend",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test": "echo \"No tests yet\"",
    "dev": "nodemon --watch src --ext ts --exec \"ts-node --files src/app.ts\"",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "verify:static": "npm run verify:create-quests && npm run verify:collections && npm run verify:feedback-v1 && npm run verify:seed-preservation && npm run verify:dfs-learning && npm run verify:feedback-concepts && npm run verify:feedback-evidence-storage && npm run verify:feedback-candidates && npm run verify:feedback-v1-context && npm run verify:feedback-v1-storage && npm run verify:feedback-tasks && npm run verify:big-goal && npm run verify:big-goal-proposal && npm run verify:big-goal-generation",
    "reset:learning-course": "ts-node src/scripts/resetCourseLearningState.ts",
    "test:e2e:learning": "ts-node src/scripts/e2eLearningFlow.ts",
    "verify:create-quests": "ts-node src/scripts/verifyCreateQuestReferenceSolutions.ts",
    "verify:collections": "ts-node src/scripts/verifyCollectionMasterData.ts",
    "verify:dfs-learning": "ts-node src/scripts/verifyDfsLearningIntegration.ts",
    "test:e2e:collections": "ts-node src/scripts/e2eCollectionRewards.ts",
    "test:e2e:create-achievements": "ts-node src/scripts/e2eCreateQuestAchievements.ts",
    "start": "node dist/src/app.js",
    "lint": "eslint src --ext .ts",
    "verify:feedback-v1": "ts-node src/scripts/verifyFeedbackV1.ts",
    "verify:feedback-v1-storage": "ts-node src/scripts/verifyFeedbackV1Storage.ts",
    "verify:feedback-tasks": "ts-node src/scripts/verifyFeedbackV1Tasks.ts",
    "verify:feedback-v1-context": "ts-node src/scripts/verifyFeedbackV1Context.ts",
    "seed:preserve": "ts-node prisma/seed.ts --preserve-existing",
    "verify:seed-preservation": "ts-node src/scripts/verifyPreservingSeed.ts",
    "verify:big-goal": "ts-node src/scripts/verifyBigGoal.ts",
    "verify:big-goal-proposal": "ts-node src/scripts/verifyBigGoalProposal.ts",
    "verify:feedback-concepts": "ts-node src/scripts/verifyFeedbackConcepts.ts",
    "verify:feedback-evidence-storage": "ts-node src/scripts/verifyFeedbackEvidenceStorage.ts",
    "verify:feedback-candidates": "ts-node src/scripts/verifyFeedbackCandidates.ts",
    "verify:big-goal-generation": "ts-node src/scripts/verifyBigGoalGeneration.ts"
  },
  "keywords": [],
