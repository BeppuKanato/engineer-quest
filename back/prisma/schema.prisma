// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// User
// =========================

model User {
  id           String  @id @default(cuid())
  firebaseUid  String  @unique
  displayName  String?
  experience   Int     @default(0)
  badgeTickets Int     @default(0)
  selectedTechIconBadgeId String?

  missionProgresses  UserMissionProgress[]
  activityProgresses UserMissionActivityProgress[]
  achievements        UserAchievement[]
  knowledgeCards      UserKnowledgeCard[]
  techIconBadges       UserTechIconBadge[]
  badgeTicketTransactions BadgeTicketTransaction[]
  selectedTechIconBadge TechIconBadge? @relation("SelectedTechIconBadge", fields: [selectedTechIconBadgeId], references: [id], onDelete: SetNull)
  works                UserWork[]
  questPosts           QuestPost[]
  questComments        QuestComment[]
  questReactions       QuestReaction[]
  missionRewardRuns    MissionRewardRun[]

  activityAnswerLogs ActivityAnswerLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// Course Master
// =========================

model Course {
  id          String           @id @default(cuid())
  title       String
  description String
  difficulty  CourseDifficulty

  isInitiallyUnlocked Boolean @default(true)
  isPublished         Boolean @default(true)
  version             Int     @default(1)

  missions   Mission[]
  categories CourseCategoryMap[]
  achievements Achievement[]
  knowledgeCards KnowledgeCard[]
  createMissions CreateMission[]
  works UserWork[]
  questPosts QuestPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseCategory {
  id   String             @id @default(cuid())
  name CourseCategoryType @unique

  courses CourseCategoryMap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseCategoryMap {
  courseId   String
  categoryId String

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([courseId, categoryId])
}

// =========================
// Mission Master
// =========================

model Mission {
  id          String           @id @default(cuid())
  courseId    String
  title       String
  description String
  difficulty  CourseDifficulty
  goalImg     String

  estimatedMinutes Int @default(10)

  // Course内での順番。Missionのロック判定に使う
  order Int

  // MAIN: 基礎ミッション
  // CHALLENGE: 挑戦ミッション
  type                          MissionType @default(MAIN)
  isRequiredForCourseCompletion Boolean     @default(true)

  // 挑戦Missionがどの基礎Missionから生えるか
  parentMissionId String?

  // ロードマップ表示用
  roadmapLane Int @default(0)
  branchOrder Int @default(0)

  // Mission完了時の表示用
  rewardExp    Int      @default(100)
  learnedItems String[] @default([])

  isPublished Boolean @default(true)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  parentMission  Mission?  @relation("MissionBranch", fields: [parentMissionId], references: [id], onDelete: SetNull)
  branchMissions Mission[] @relation("MissionBranch")

  sections   MissionSection[]
  activities MissionActivity[]

  progresses UserMissionProgress[]
  achievements Achievement[]
  createMissions CreateMission[]
  works UserWork[]
  questPosts QuestPost[]
  rewardRuns MissionRewardRun[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
  @@index([courseId, type])
  @@index([parentMissionId])
}

// =========================
// Section / Activity Master
// =========================

model MissionSection {
  id          String @id @default(cuid())
  missionId   String
  title       String
  description String?

  // Mission内のSection順
  order Int

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  activities MissionActivity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([missionId, order])
  @@index([missionId])
}

model MissionActivity {
  id        String           @id @default(cuid())
  missionId String
  sectionId String?

  type  MissionActivityType
  title String

  // 問題文・指示文。TUTORIALでも空にしない方針
  instruction String

  // メンターの一言、説明、補足
  mentorMessage String

  // choices, matchItems, orderedSteps, checkItems, body, summary などをまとめる
  content Json

  // preview type, title, html, caption, previewKey, minHeight などをまとめる
  preview Json?

  actionLabel String

  // Mission全体でのActivity順
  order Int

  // Section内での表示順。sectionIdがある場合に使う
  sectionOrder Int?

  // Mission Checkの問題かどうか
  isMissionCheck Boolean @default(false)

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  section MissionSection? @relation(fields: [sectionId], references: [id], onDelete: SetNull)

  progresses UserMissionActivityProgress[]
  answerLogs ActivityAnswerLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([missionId, order])
  @@index([missionId])
  @@index([sectionId])
  @@index([missionId, isMissionCheck])
}

// =========================
// User Progress
// =========================

model UserMissionProgress {
  id        String @id @default(cuid())
  userId    String
  missionId String

  status ProgressStatus @default(IN_PROGRESS)
  awardedExp Int @default(0)

  // 続きから再開用
  currentActivityId String?

  startedAt   DateTime?
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, missionId])
  @@index([userId])
  @@index([missionId])
}

// =========================
// Achievement
// =========================

model Achievement {
  id          String              @id @default(cuid())
  title       String
  description String
  category    AchievementCategory

  conditionType  AchievementConditionType
  conditionValue Int?
  missionId      String?
  courseId       String?

  isSecret  Boolean @default(false)
  sortOrder Int     @default(0)

  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  userAchievements UserAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([conditionType])
  @@index([missionId])
  @@index([courseId])
}

model UserAchievement {
  id            String @id @default(cuid())
  userId        String
  achievementId String

  achievedAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

// =========================
// Knowledge Card
// =========================

model KnowledgeCard {
  id          String @id @default(cuid())
  courseId    String
  label       String
  title       String
  description String
  rarity      KnowledgeCardRarity @default(COMMON)
  sortOrder   Int @default(0)
  isPublished Boolean @default(true)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userKnowledgeCards UserKnowledgeCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([rarity])
}

model UserKnowledgeCard {
  id              String @id @default(cuid())
  userId          String
  knowledgeCardId String

  collectedAt DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeCard KnowledgeCard @relation(fields: [knowledgeCardId], references: [id], onDelete: Cascade)

  @@unique([userId, knowledgeCardId])
  @@index([userId])
  @@index([knowledgeCardId])
}

// =========================
// Tech Icon Badge
// =========================

model TechIconBadge {
  id          String @id @default(cuid())
  name        String
  description String
  iconUrl     String
  rarity      TechIconBadgeRarity @default(COMMON)
  sortOrder   Int @default(0)
  isPublished Boolean @default(true)

  userTechIconBadges UserTechIconBadge[]
  selectedByUsers User[] @relation("SelectedTechIconBadge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rarity])
  @@index([sortOrder])
}

model UserTechIconBadge {
  id        String @id @default(cuid())
  userId    String
  badgeId   String

  acquiredAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge TechIconBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model BadgeTicketTransaction {
  id       String @id @default(cuid())
  userId   String
  amount   Int
  reason   BadgeTicketReason
  sourceId String?
  note     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([reason])
  @@index([sourceId])
}

// =========================
// Mission Reward Flow
// =========================

model MissionRewardRun {
  id String @id @default(cuid())

  userId String
  missionId String

  candidateKnowledgeCardIds String[] @default([])
  selectedKnowledgeCardId String?
  knowledgeCardSelectedAt DateTime?

  unlockedAchievementIds String[] @default([])

  awardedExp Int @default(0)
  awardedBadgeTickets Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([missionId])
  @@index([createdAt])
}

// =========================
// Create Mission / My Works
// =========================

model CreateMission {
  id          String @id @default(cuid())
  courseId    String
  missionId   String?
  title       String
  theme       String
  description String
  minimumRequirements String[] @default([])
  advancedRequirements String[] @default([])
  suggestedTechnologies String[] @default([])
  starterCode String?
  sortOrder   Int @default(0)
  isPublished Boolean @default(true)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  works UserWork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([missionId])
  @@index([sortOrder])
}

model UserWork {
  id              String @id @default(cuid())
  userId          String
  createMissionId String
  courseId        String
  missionId       String?

  title       String
  description String
  focusPoint  String
  technologies String[] @default([])
  code        String
  isFavorite  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  createMission CreateMission @relation(fields: [createMissionId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  reviews UserWorkReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createMissionId])
  @@index([courseId])
  @@index([missionId])
}

model UserWorkReview {
  id         String @id @default(cuid())
  userWorkId String
  goodPoints String
  improvements String
  nextTry String
  rawText String

  userWork UserWork @relation(fields: [userWorkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userWorkId])
}

// =========================
// Quest Board
// =========================

model QuestPost {
  id           String @id @default(cuid())
  userId       String
  category     QuestPostCategory
  title        String
  body         String
  code         String?
  referenceUrl String?
  courseId     String?
  missionId    String?
  status       QuestPostStatus @default(OPEN)
  visibility   QuestPostVisibility @default(PUBLIC)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  comments  QuestComment[]
  reactions QuestReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([courseId])
  @@index([missionId])
  @@index([createdAt])
}

model QuestComment {
  id     String @id @default(cuid())
  postId String
  userId String
  body   String

  post QuestPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
}

model QuestReaction {
  id     String @id @default(cuid())
  postId String
  userId String
  type   QuestReactionType

  post QuestPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
  @@index([type])
}

model UserMissionActivityProgress {
  id         String @id @default(cuid())
  userId     String
  activityId String

  status ProgressStatus @default(IN_PROGRESS)

  startedAt   DateTime?
  completedAt DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity MissionActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, activityId])
  @@index([userId])
  @@index([activityId])
}

// =========================
// Logs
// =========================

model ActivityAnswerLog {
  id         String @id @default(cuid())
  userId     String
  activityId String

  // selectedChoiceId, selectedIds, orderedIds, matchPairs, userAnswer などを保存
  answer Json

  isCorrect Boolean?

  answeredAt DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity MissionActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activityId])
}

// =========================
// Enums
// =========================

enum CourseDifficulty {
  EASY
  NORMAL
  HARD
}

enum MissionType {
  MAIN
  CHALLENGE
}

enum CourseCategoryType {
  GAME
  ALGORITHM
  TOOL
  UI
  DATA
}

enum MissionActivityType {
  TUTORIAL
  VIEW
  CHOICE
  MATCH
  ORDERED_STEPS
  SELECT_FILL
  TRY_CODE
  MISSION_CHECK
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum AchievementCategory {
  MISSION_COUNT
  MISSION_CLEAR
  MISSION_COMPLETE
  COURSE_EXAM
  LEARNING_ACTION
  COURSE_COMPLETE
  STREAK
}

enum AchievementConditionType {
  MISSION_COUNT
  SPECIFIC_MISSION_CLEAR
  COURSE_REQUIRED_MISSION_COMPLETE
  COURSE_ALL_MISSION_COMPLETE
  COURSE_EXAM_HARD_CLEAR
  ACTIVITY_COUNT
  COURSE_COMPLETE
  STREAK_DAYS
}

enum KnowledgeCardRarity {
  COMMON
  RARE
  EPIC
}

enum TechIconBadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum BadgeTicketReason {
  MISSION_COMPLETE
  CHALLENGE_COMPLETE
  COURSE_COMPLETE
  ACHIEVEMENT_UNLOCK
  BADGE_GACHA
  CREATE_WORK_SAVE
  CREATE_WORK_REVIEW
}

enum QuestPostCategory {
  QUESTION
  ERROR_HELP
  WORK_SHARE
  CODE_SHARE
  MEMO
  REFERENCE
}

enum QuestPostStatus {
  OPEN
  RESOLVED
}

enum QuestPostVisibility {
  PUBLIC
}

enum QuestReactionType {
  LIKE
  HELPFUL
  SAVED_ME
}
