// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// User
// =========================

model User {
  id                          String  @id @default(cuid())
  firebaseUid                 String  @unique
  displayName                 String?
  experience                  Int     @default(0)
  knowledgeCardTableNumber    Int     @default(1)
  selectedMascotId            String  @default("red-panda")
  selectedTargetAchievementId String?
  selectedProfileAchievementId String?

  achievements              UserAchievement[]
  knowledgeCards            UserKnowledgeCard[]
  selectedTargetAchievement Achievement?                  @relation("SelectedTargetAchievement", fields: [selectedTargetAchievementId], references: [id], onDelete: SetNull)
  selectedProfileAchievement Achievement?                 @relation("SelectedProfileAchievement", fields: [selectedProfileAchievementId], references: [id], onDelete: SetNull)
  createQuestAttempts       CreateQuestAttempt[]
  questPosts                QuestPost[]
  questComments             QuestComment[]
  questReactions            QuestReaction[]
  hexadResponse             HexadResponse?
  experimentAssignments     ExperimentAssignment[]

  feedbackV1Records FeedbackV1[]
  unitProgresses    UnitLearningProgress[]
  phaseProgresses   PhaseLearningProgress[]
  learningEvents    LearningEvent[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// HEXAD Questionnaire
// =========================

model HexadResponse {
  id                   String @id @default(cuid())
  userId               String @unique
  questionnaireVersion String

  q1  Int
  q2  Int
  q3  Int
  q4  Int
  q5  Int
  q6  Int
  q7  Int
  q8  Int
  q9  Int
  q10 Int
  q11 Int
  q12 Int
  q13 Int
  q14 Int
  q15 Int
  q16 Int
  q17 Int
  q18 Int
  q19 Int
  q20 Int
  q21 Int
  q22 Int
  q23 Int
  q24 Int

  philanthropistScore Int
  socialiserScore     Int
  freeSpiritScore     Int
  achieverScore       Int
  disruptorScore      Int
  playerScore         Int

  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExperimentAssignment {
  id            String            @id @default(cuid())
  userId        String
  experimentKey String
  condition     FeedbackCondition
  assignedAt    DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, experimentKey])
  @@index([experimentKey, condition])
}

// =========================
// Course Master
// =========================

model Course {
  id          String           @id @default(cuid())
  title       String
  description String
  difficulty  CourseDifficulty

  isInitiallyUnlocked Boolean @default(true)
  isPublished         Boolean @default(true)
  version             Int     @default(1)

  categories       CourseCategoryMap[]
  achievements     Achievement[]
  knowledgeCards   KnowledgeCard[]
  createQuestLinks CreateQuestCourse[]
  unitProgresses   UnitLearningProgress[]
  phaseProgresses  PhaseLearningProgress[]
  knowledgeCardPhaseScheduleEntries KnowledgeCardPhaseScheduleEntry[]
  questPosts       QuestPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseCategory {
  id   String             @id @default(cuid())
  name CourseCategoryType @unique

  courses CourseCategoryMap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseCategoryMap {
  courseId   String
  categoryId String

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([courseId, categoryId])
}

// =========================
// Activity Master
// =========================


// =========================
// User Progress
// =========================


// =========================
// COURSE_EXAM Attempts
// =========================


// =========================
// Achievement
// =========================

model Achievement {
  id          String              @id @default(cuid())
  title       String
  description String
  category    AchievementCategory
  rarity      AchievementRarity   @default(COMMON)
  iconKey     String              @default("achievement")

  conditionType  AchievementConditionType
  conditionValue Int?
  courseId       String?
  createQuestId  String?
  phaseKey       String?

  isSecret  Boolean @default(false)
  sortOrder Int     @default(0)

  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  createQuest CreateQuest? @relation(fields: [createQuestId], references: [id], onDelete: SetNull)

  userAchievements        UserAchievement[]
  selectedAsTargetByUsers User[]            @relation("SelectedTargetAchievement")
  selectedForProfileByUsers User[]           @relation("SelectedProfileAchievement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([conditionType])
  @@index([courseId])
  @@index([createQuestId])
}

model UserAchievement {
  id            String @id @default(cuid())
  userId        String
  achievementId String

  achievedAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

// =========================
// Knowledge Card
// =========================

model KnowledgeCard {
  id          String              @id @default(cuid())
  courseId    String
  label       String
  title       String
  description String
  connection  String
  useCase     String
  searchKeywords String[] @default([])
  catalogNumber Int
  rarity      KnowledgeCardRarity @default(COMMON)
  sortOrder   Int                 @default(0)
  isPublished Boolean             @default(true)

  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userKnowledgeCards UserKnowledgeCard[]
  phaseScheduleEntries KnowledgeCardPhaseScheduleEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([rarity])
  @@unique([courseId, catalogNumber])
}

model UserKnowledgeCard {
  id              String @id @default(cuid())
  userId          String
  knowledgeCardId String

  collectedAt DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeCard KnowledgeCard @relation(fields: [knowledgeCardId], references: [id], onDelete: Cascade)

  @@unique([userId, knowledgeCardId])
  @@index([userId])
  @@index([knowledgeCardId])
}

// =========================
// Knowledge Card Schedule
// =========================


// =========================
// Create Quest
// =========================

model CreateQuest {
  id               String   @id
  title            String
  description      String
  scenario         String
  problemType      String
  functionName     String
  starterCode      String
  estimatedMinutes Int      @default(45)
  tags             String[] @default([])
  thumbnailUrl     String?
  previewData      Json
  sortOrder        Int      @default(0)
  isPublished      Boolean  @default(true)

  requirements   CreateQuestRequirement[]
  relatedCourses CreateQuestCourse[]
  attempts       CreateQuestAttempt[]
  achievements   Achievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@index([problemType])
}

model CreateQuestRequirement {
  id          String                         @id
  questId     String
  title       String
  description String
  kind        CreateQuestRequirementKind
  category    CreateQuestRequirementCategory
  points      Int
  order       Int                            @default(0)
  tests       Json
  hints       Json

  quest     CreateQuest           @relation(fields: [questId], references: [id], onDelete: Cascade)
  hintViews CreateQuestHintView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([questId, order])
  @@index([kind])
}

model CreateQuestCourse {
  questId  String
  courseId String
  reason   String
  order    Int    @default(0)

  quest  CreateQuest @relation(fields: [questId], references: [id], onDelete: Cascade)
  course Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@id([questId, courseId])
  @@index([courseId])
}

model CreateQuestAttempt {
  id                     String                   @id @default(cuid())
  userId                 String
  questId                String
  code                   String
  selectedRequirementIds String[]                 @default([])
  status                 CreateQuestAttemptStatus @default(IN_PROGRESS)
  bestScore              Int                      @default(0)
  startedAt              DateTime                 @default(now())
  completedAt            DateTime?

  user        User                       @relation(fields: [userId], references: [id], onDelete: Cascade)
  quest       CreateQuest                @relation(fields: [questId], references: [id], onDelete: Cascade)
  executions  CreateQuestTestExecution[]
  submissions CreateQuestSubmission[]
  hintViews   CreateQuestHintView[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, questId])
  @@index([userId, updatedAt])
  @@index([questId])
}

model CreateQuestTestExecution {
  id           String   @id @default(cuid())
  attemptId    String
  code         String
  score        Int
  basicPassed  Boolean
  results      Json
  runtimeError String?
  executedAt   DateTime @default(now())

  attempt CreateQuestAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, executedAt])
}

model CreateQuestSubmission {
  id          String   @id @default(cuid())
  attemptId   String
  code        String
  score       Int
  maxScore    Int
  basicPassed Boolean
  results     Json
  submittedAt DateTime @default(now())

  attempt  CreateQuestAttempt   @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  feedback CreateQuestFeedback?

  @@index([attemptId, submittedAt])
}

model CreateQuestHintView {
  id            String   @id @default(cuid())
  attemptId     String
  requirementId String
  hintId        String
  viewedAt      DateTime @default(now())

  attempt     CreateQuestAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  requirement CreateQuestRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@unique([attemptId, requirementId, hintId])
  @@index([attemptId, viewedAt])
}

model CreateQuestFeedback {
  id           String @id @default(cuid())
  submissionId String @unique

  status    CourseExamFeedbackStatus
  condition FeedbackCondition

  currentState String?
  nextGoal     String?
  nextStep     String?
  actionType   CourseExamFeedbackActionType?
  actionLabel  String?

  learningAnalysis  Json?
  selectionAnalysis Json?
  inputSnapshot     Json

  model            String
  openAiResponseId String?
  usage            Json?
  failureCode      String?
  generatedAt      DateTime?

  submission CreateQuestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([condition])
}

// =========================
// Quest Board
// =========================

model QuestPost {
  id           String              @id @default(cuid())
  userId       String
  category     QuestPostCategory
  title        String
  body         String
  code         String?
  referenceUrl String?
  courseId     String?
  status       QuestPostStatus     @default(OPEN)
  visibility   QuestPostVisibility @default(PUBLIC)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  comments  QuestComment[]
  reactions QuestReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([courseId])
  @@index([createdAt])
}

model QuestComment {
  id     String @id @default(cuid())
  postId String
  userId String
  body   String

  post QuestPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
}

model QuestReaction {
  id     String            @id @default(cuid())
  postId String
  userId String
  type   QuestReactionType

  post QuestPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
  @@index([type])
}


// =========================
// Logs
// =========================


// =========================
// Enums
// =========================

enum CourseDifficulty {
  EASY
  NORMAL
  HARD
}

enum FeedbackCondition {
  STANDARD
  PERSONALIZED
}

enum CourseExamFeedbackStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum CourseExamFeedbackActionType {
  RETRY_COURSE_EXAM
  SOLVE_PRACTICE_PROBLEM
  CREATE_LEARNING_MEMO
  CREATE_QUESTION_POST
  CREATE_ERROR_HELP_POST
  CREATE_WORK_POST
  VIEW_BOARD_POSTS
  ANSWER_BOARD_POST
  REVIEW_KNOWLEDGE_CARDS
  VIEW_ACHIEVEMENTS
  SET_TARGET_ACHIEVEMENT
  USE_BADGE_TICKET
  VIEW_BADGE_COLLECTION
  SET_PROFILE_BADGE
  VIEW_PROFILE
  RETRY_CREATE_QUEST
  OPEN_RELATED_COURSE
  SHARE_CREATE_QUEST
  NO_APP_ACTION
}


enum CourseCategoryType {
  GAME
  ALGORITHM
  TOOL
  UI
  DATA
  SORT
  SEARCH
  GRAPH
  DATA_STRUCTURE
  DYNAMIC_PROGRAMMING
}

enum CreateQuestRequirementKind {
  BASIC
  OPTIONAL
}

enum CreateQuestRequirementCategory {
  FUNCTIONAL
  QUALITY
  PERFORMANCE
  IMPLEMENTATION
}

enum CreateQuestAttemptStatus {
  IN_PROGRESS
  COMPLETED
}


enum AchievementCategory {
  MISSION_COUNT
  MISSION_CLEAR
  MISSION_COMPLETE
  COURSE_EXAM
  LEARNING_ACTION
  COURSE_COMPLETE
  STREAK
  CREATE_QUEST
  COLLECTION
}

enum AchievementConditionType {
  MISSION_COUNT
  SPECIFIC_MISSION_CLEAR
  COURSE_REQUIRED_MISSION_COMPLETE
  COURSE_ALL_MISSION_COMPLETE
  COURSE_EXAM_HARD_CLEAR
  ACTIVITY_COUNT
  COURSE_COMPLETE
  STREAK_DAYS
  CREATE_QUEST_SCORE
  CREATE_QUEST_COMPLETED_COUNT
  CREATE_QUEST_OPTIONAL_REQUIREMENT_COUNT
  CREATE_QUEST_PERFECT_COUNT
  KNOWLEDGE_CARD_COUNT
  COURSE_COMPLETED_COUNT
  UNIT_COMPLETE
  UNIT_COMPLETED_COUNT
  PHASE_COMPLETED
  PHASE_FIRST_ATTEMPT_PERFECT
  PHASE_NO_HINT_COMPLETE
}

enum AchievementRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum KnowledgeCardRarity {
  COMMON
  RARE
  EPIC
}

enum QuestPostCategory {
  QUESTION
  ERROR_HELP
  WORK_SHARE
  CODE_SHARE
  MEMO
  REFERENCE
}

enum QuestPostStatus {
  OPEN
  RESOLVED
}

enum QuestPostVisibility {
  PUBLIC
}

enum QuestReactionType {
  LIKE
  HELPFUL
  SAVED_ME
}

model FeedbackV1 {
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 id String @id @default(cuid())
 userId String
 eventKey String @unique
 condition FeedbackCondition
 status CourseExamFeedbackStatus
 input Json
 result Json?
 failureCode String?
 createdAt DateTime @default(now())
 generatedAt DateTime?
 calls FeedbackV1Call[]
 interactions FeedbackV1Interaction[]
 @@index([userId, createdAt])
}
model FeedbackV1Call {
 id String @id @default(cuid())
 feedbackId String
 data Json
 createdAt DateTime @default(now())
 feedback FeedbackV1 @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
}
model FeedbackV1Interaction {
 id String @id
 feedbackId String
 type String
 data Json
 createdAt DateTime @default(now())
 feedback FeedbackV1 @relation(fields: [feedbackId], references: [id], onDelete: Cascade)
 @@index([feedbackId, createdAt])
}

// =========================
// New-flow learning progress / events
// =========================

enum LearningProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
}

model UnitLearningProgress {
  id           String                 @id @default(cuid())
  userId       String
  courseId     String
  status       LearningProgressStatus @default(IN_PROGRESS)
  lastPhaseKey String?
  startedAt    DateTime               @default(now())
  completedAt  DateTime?
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
}

model PhaseLearningProgress {
  id          String                 @id @default(cuid())
  userId      String
  courseId    String
  phaseKey    String
  status      LearningProgressStatus @default(IN_PROGRESS)
  summary     Json?
  startedAt   DateTime               @default(now())
  completedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId, phaseKey])
  @@index([userId, courseId])
}

model LearningEvent {
  id              String   @id @default(cuid())
  userId          String
  sessionId       String
  eventType       String
  courseId        String?
  phaseKey        String?
  targetId        String?
  payload         Json?
  clientTimestamp DateTime
  serverTimestamp DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionId, serverTimestamp])
  @@index([userId, courseId])
}

model KnowledgeCardPhaseScheduleEntry {
  id              String @id @default(cuid())
  courseId        String
  courseVersion   Int
  tableNumber     Int
  phaseKey        String
  knowledgeCardId String

  course        Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  knowledgeCard KnowledgeCard @relation(fields: [knowledgeCardId], references: [id], onDelete: Cascade)

  @@unique([courseId, courseVersion, tableNumber, phaseKey])
  @@index([courseId, tableNumber])
}
