// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =========================
// User
// =========================

model User {
  id                          String  @id @default(cuid())
  firebaseUid                 String  @unique
  displayName                 String?
  experience                  Int     @default(0)
  badgeTickets                Int     @default(0)
  selectedTechIconBadgeId     String?
  selectedMascotId            String  @default("red-panda")
  selectedTargetAchievementId String?

  missionProgresses         UserMissionProgress[]
  activityProgresses        UserMissionActivityProgress[]
  achievements              UserAchievement[]
  knowledgeCards            UserKnowledgeCard[]
  techIconBadges            UserTechIconBadge[]
  badgeTicketTransactions   BadgeTicketTransaction[]
  selectedTechIconBadge     TechIconBadge?                @relation("SelectedTechIconBadge", fields: [selectedTechIconBadgeId], references: [id], onDelete: SetNull)
  selectedTargetAchievement Achievement?                  @relation("SelectedTargetAchievement", fields: [selectedTargetAchievementId], references: [id], onDelete: SetNull)
  works                     UserWork[]
  createWorks               UserCreateWork[]
  questPosts                QuestPost[]
  questComments             QuestComment[]
  questReactions            QuestReaction[]
  missionRewardRuns         MissionRewardRun[]
  courseExamAttempts        CourseExamAttempt[]
  hexadResponse             HexadResponse?
  experimentAssignments     ExperimentAssignment[]

  activityAnswerLogs ActivityAnswerLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =========================
// HEXAD Questionnaire
// =========================

model HexadResponse {
  id                   String @id @default(cuid())
  userId               String @unique
  questionnaireVersion String

  q1  Int
  q2  Int
  q3  Int
  q4  Int
  q5  Int
  q6  Int
  q7  Int
  q8  Int
  q9  Int
  q10 Int
  q11 Int
  q12 Int
  q13 Int
  q14 Int
  q15 Int
  q16 Int
  q17 Int
  q18 Int
  q19 Int
  q20 Int
  q21 Int
  q22 Int
  q23 Int
  q24 Int

  philanthropistScore Int
  socialiserScore     Int
  freeSpiritScore     Int
  achieverScore       Int
  disruptorScore      Int
  playerScore         Int

  completedAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ExperimentAssignment {
  id            String            @id @default(cuid())
  userId        String
  experimentKey String
  condition     FeedbackCondition
  assignedAt    DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, experimentKey])
  @@index([experimentKey, condition])
}

// =========================
// Course Master
// =========================

model Course {
  id          String           @id @default(cuid())
  title       String
  description String
  difficulty  CourseDifficulty

  isInitiallyUnlocked Boolean @default(true)
  isPublished         Boolean @default(true)
  version             Int     @default(1)

  missions       Mission[]
  categories     CourseCategoryMap[]
  achievements   Achievement[]
  knowledgeCards KnowledgeCard[]
  createMissions CreateMission[]
  works          UserWork[]
  createThemes   CreateTheme[]
  createWorks    UserCreateWork[]
  questPosts     QuestPost[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseCategory {
  id   String             @id @default(cuid())
  name CourseCategoryType @unique

  courses CourseCategoryMap[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model CourseCategoryMap {
  courseId   String
  categoryId String

  course   Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  category CourseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([courseId, categoryId])
}

// =========================
// Mission Master
// =========================

model Mission {
  id          String           @id @default(cuid())
  courseId    String
  title       String
  description String
  difficulty  CourseDifficulty
  goalImg     String

  estimatedMinutes Int @default(10)

  // Course内での順番。Missionのロック判定に使う
  order Int

  // MAIN: 基礎ミッション
  // CHALLENGE: 挑戦ミッション
  // COURSE_EXAM: コース完了ミッション
  type                          MissionType @default(MAIN)
  isRequiredForCourseCompletion Boolean     @default(true)

  // 挑戦Missionがどの基礎Missionから生えるか
  parentMissionId String?

  // ロードマップ表示用
  roadmapLane Int @default(0)
  branchOrder Int @default(0)

  // Mission完了時の表示用
  rewardExp    Int      @default(100)
  learnedItems String[] @default([])

  isPublished Boolean @default(true)

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  parentMission  Mission?  @relation("MissionBranch", fields: [parentMissionId], references: [id], onDelete: SetNull)
  branchMissions Mission[] @relation("MissionBranch")

  activities MissionActivity[]

  progresses     UserMissionProgress[]
  achievements   Achievement[]
  createMissions CreateMission[]
  works          UserWork[]
  questPosts     QuestPost[]
  rewardRuns     MissionRewardRun[]
  examAttempts   CourseExamAttempt[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, order])
  @@index([courseId, type])
  @@index([parentMissionId])
}

// =========================
// Activity Master
// =========================

model MissionActivity {
  id        String @id @default(cuid())
  missionId String

  type  MissionActivityType
  title String

  // 問題文・指示文。TUTORIALでも空にしない方針
  instruction String

  // メンターの一言、説明、補足
  mentorMessage String

  // choices, matchItems, orderedSteps, checkItems, body, summary などをまとめる
  content Json

  // preview type, title, html, caption, previewKey, minHeight などをまとめる
  preview Json?

  actionLabel String

  // Mission全体でのActivity順
  order Int

  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  progresses UserMissionActivityProgress[]
  answerLogs ActivityAnswerLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([missionId, order])
  @@index([missionId])
}

// =========================
// User Progress
// =========================

model UserMissionProgress {
  id        String @id @default(cuid())
  userId    String
  missionId String

  status     ProgressStatus @default(IN_PROGRESS)
  awardedExp Int            @default(0)

  selectedExamDifficulty       CourseDifficulty?
  highestClearedExamDifficulty CourseDifficulty?
  examAttemptCount             Int               @default(0)
  examHintCount                Int               @default(0)

  // 続きから再開用
  currentActivityId String?

  startedAt   DateTime?
  completedAt DateTime?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission Mission @relation(fields: [missionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, missionId])
  @@index([userId])
  @@index([missionId])
}

// =========================
// COURSE_EXAM Attempts
// =========================

model CourseExamAttempt {
  id        String @id @default(cuid())
  userId    String
  missionId String

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission        Mission                   @relation(fields: [missionId], references: [id], onDelete: Cascade)
  hintViews      CourseExamHintView[]
  testExecutions CourseExamTestExecution[]
  submissions    CourseExamSubmission[]
  rewardRun      MissionRewardRun?
  feedback       CourseExamFeedback?

  @@index([userId, missionId])
  @@index([missionId])
  @@index([startedAt])
}

model CourseExamHintView {
  id        String @id @default(cuid())
  attemptId String
  hintId    String

  viewedAt DateTime @default(now())

  attempt CourseExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, hintId])
  @@index([attemptId])
}

model CourseExamTestExecution {
  id        String @id @default(cuid())
  attemptId String
  code      String

  testResults  Json
  runtimeError String?

  executedAt DateTime @default(now())

  attempt CourseExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, executedAt])
}

model CourseExamSubmission {
  id        String @id @default(cuid())
  attemptId String
  code      String

  passed      Boolean
  testResults Json

  submittedAt DateTime @default(now())

  attempt CourseExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, submittedAt])
}

model CourseExamFeedback {
  id        String @id @default(cuid())
  attemptId String @unique

  status    CourseExamFeedbackStatus
  condition FeedbackCondition

  currentState String?
  nextGoal     String?
  nextStep     String?
  actionType   CourseExamFeedbackActionType?
  actionLabel  String?

  learningAnalysis  Json?
  selectionAnalysis Json?
  inputSnapshot     Json

  model            String
  promptVersion    String
  openAiResponseId String?
  usage            Json?
  failureCode      String?
  generatedAt      DateTime?

  attempt CourseExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([condition])
  @@index([createdAt])
}

// =========================
// Achievement
// =========================

model Achievement {
  id          String              @id @default(cuid())
  title       String
  description String
  category    AchievementCategory

  conditionType  AchievementConditionType
  conditionValue Int?
  missionId      String?
  courseId       String?

  isSecret  Boolean @default(false)
  sortOrder Int     @default(0)

  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)

  userAchievements        UserAchievement[]
  selectedAsTargetByUsers User[]            @relation("SelectedTargetAchievement")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([conditionType])
  @@index([missionId])
  @@index([courseId])
}

model UserAchievement {
  id            String @id @default(cuid())
  userId        String
  achievementId String

  achievedAt DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId])
  @@index([achievementId])
}

// =========================
// Knowledge Card
// =========================

model KnowledgeCard {
  id          String              @id @default(cuid())
  courseId    String
  label       String
  title       String
  description String
  rarity      KnowledgeCardRarity @default(COMMON)
  sortOrder   Int                 @default(0)
  isPublished Boolean             @default(true)

  course             Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  userKnowledgeCards UserKnowledgeCard[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([rarity])
}

model UserKnowledgeCard {
  id              String @id @default(cuid())
  userId          String
  knowledgeCardId String

  collectedAt DateTime @default(now())

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  knowledgeCard KnowledgeCard @relation(fields: [knowledgeCardId], references: [id], onDelete: Cascade)

  @@unique([userId, knowledgeCardId])
  @@index([userId])
  @@index([knowledgeCardId])
}

// =========================
// Tech Icon Badge
// =========================

model TechIconBadge {
  id          String              @id @default(cuid())
  name        String
  description String
  iconUrl     String
  rarity      TechIconBadgeRarity @default(COMMON)
  sortOrder   Int                 @default(0)
  isPublished Boolean             @default(true)

  userTechIconBadges UserTechIconBadge[]
  selectedByUsers    User[]              @relation("SelectedTechIconBadge")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rarity])
  @@index([sortOrder])
}

model UserTechIconBadge {
  id      String @id @default(cuid())
  userId  String
  badgeId String

  acquiredAt DateTime @default(now())

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge TechIconBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
}

model BadgeTicketTransaction {
  id       String            @id @default(cuid())
  userId   String
  amount   Int
  reason   BadgeTicketReason
  sourceId String?
  note     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([reason])
  @@index([sourceId])
}

// =========================
// Mission Reward Flow
// =========================

model MissionRewardRun {
  id String @id @default(cuid())

  userId              String
  missionId           String
  courseExamAttemptId String? @unique

  candidateKnowledgeCardIds String[]  @default([])
  selectedKnowledgeCardId   String?
  knowledgeCardSelectedAt   DateTime?

  unlockedAchievementIds String[] @default([])

  awardedExp          Int @default(0)
  awardedBadgeTickets Int @default(0)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  mission           Mission            @relation(fields: [missionId], references: [id], onDelete: Cascade)
  courseExamAttempt CourseExamAttempt? @relation(fields: [courseExamAttemptId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([missionId])
  @@index([createdAt])
}

// =========================
// Create Mission / My Works
// =========================

model CreateMission {
  id                    String   @id @default(cuid())
  courseId              String
  missionId             String?
  title                 String
  theme                 String
  description           String
  minimumRequirements   String[] @default([])
  advancedRequirements  String[] @default([])
  suggestedTechnologies String[] @default([])
  starterCode           String?
  sortOrder             Int      @default(0)
  isPublished           Boolean  @default(true)

  course  Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mission Mission?   @relation(fields: [missionId], references: [id], onDelete: SetNull)
  works   UserWork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
  @@index([missionId])
  @@index([sortOrder])
}

model UserWork {
  id              String  @id @default(cuid())
  userId          String
  createMissionId String
  courseId        String
  missionId       String?

  title        String
  description  String
  focusPoint   String
  technologies String[] @default([])
  code         String
  isFavorite   Boolean  @default(false)

  user          User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  createMission CreateMission    @relation(fields: [createMissionId], references: [id], onDelete: Cascade)
  course        Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  mission       Mission?         @relation(fields: [missionId], references: [id], onDelete: SetNull)
  reviews       UserWorkReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([createMissionId])
  @@index([courseId])
  @@index([missionId])
}

model UserWorkReview {
  id           String @id @default(cuid())
  userWorkId   String
  goodPoints   String
  improvements String
  nextTry      String
  rawText      String

  userWork UserWork @relation(fields: [userWorkId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userWorkId])
}

// =========================
// Create Themes / My Works
// =========================

model CreateTheme {
  id                  String              @id @default(cuid())
  title               String
  description         String
  category            CreateThemeCategory
  difficulty          CourseDifficulty    @default(EASY)
  estimatedMinutes    Int                 @default(60)
  tags                String[]            @default([])
  defaultThumbnailUrl String?
  recommendedCourseId String?
  sortOrder           Int                 @default(0)
  isPublished         Boolean             @default(true)

  recommendedCourse Course?                  @relation(fields: [recommendedCourseId], references: [id], onDelete: SetNull)
  requirements      CreateThemeRequirement[]
  challenges        CreateThemeChallenge[]
  works             UserCreateWork[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([recommendedCourseId])
  @@index([sortOrder])
}

model CreateThemeRequirement {
  id          String  @id @default(cuid())
  themeId     String
  label       String
  description String?
  order       Int     @default(0)

  theme  CreateTheme                      @relation(fields: [themeId], references: [id], onDelete: Cascade)
  checks UserCreateWorkRequirementCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([themeId])
  @@index([order])
}

model CreateThemeChallenge {
  id          String  @id @default(cuid())
  themeId     String
  label       String
  description String?
  order       Int     @default(0)

  theme  CreateTheme                    @relation(fields: [themeId], references: [id], onDelete: Cascade)
  checks UserCreateWorkChallengeCheck[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([themeId])
  @@index([order])
}

model UserCreateWork {
  id       String  @id @default(cuid())
  userId   String
  themeId  String
  courseId String?

  title            String
  description      String
  learnedNote      String?
  techStack        String[]             @default([])
  publicUrl        String?
  repositoryUrl    String?
  imageUrl         String?
  imageStoragePath String?
  status           CreateWorkStatus     @default(DRAFT)
  visibility       CreateWorkVisibility @default(PRIVATE)

  user              User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  theme             CreateTheme                      @relation(fields: [themeId], references: [id], onDelete: Cascade)
  course            Course?                          @relation(fields: [courseId], references: [id], onDelete: SetNull)
  requirementChecks UserCreateWorkRequirementCheck[]
  challengeChecks   UserCreateWorkChallengeCheck[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  sharedAt  DateTime?

  @@index([userId])
  @@index([themeId])
  @@index([courseId])
  @@index([visibility])
  @@index([updatedAt])
}

model UserCreateWorkRequirementCheck {
  workId        String
  requirementId String
  checked       Boolean @default(false)

  work        UserCreateWork         @relation(fields: [workId], references: [id], onDelete: Cascade)
  requirement CreateThemeRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)

  @@id([workId, requirementId])
}

model UserCreateWorkChallengeCheck {
  workId      String
  challengeId String
  checked     Boolean @default(false)

  work      UserCreateWork       @relation(fields: [workId], references: [id], onDelete: Cascade)
  challenge CreateThemeChallenge @relation(fields: [challengeId], references: [id], onDelete: Cascade)

  @@id([workId, challengeId])
}

// =========================
// Quest Board
// =========================

model QuestPost {
  id           String              @id @default(cuid())
  userId       String
  category     QuestPostCategory
  title        String
  body         String
  code         String?
  referenceUrl String?
  courseId     String?
  missionId    String?
  status       QuestPostStatus     @default(OPEN)
  visibility   QuestPostVisibility @default(PUBLIC)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  course  Course?  @relation(fields: [courseId], references: [id], onDelete: SetNull)
  mission Mission? @relation(fields: [missionId], references: [id], onDelete: SetNull)

  comments  QuestComment[]
  reactions QuestReaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([category])
  @@index([status])
  @@index([courseId])
  @@index([missionId])
  @@index([createdAt])
}

model QuestComment {
  id     String @id @default(cuid())
  postId String
  userId String
  body   String

  post QuestPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([userId])
}

model QuestReaction {
  id     String            @id @default(cuid())
  postId String
  userId String
  type   QuestReactionType

  post QuestPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  user User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId, type])
  @@index([postId])
  @@index([userId])
  @@index([type])
}

model UserMissionActivityProgress {
  id         String @id @default(cuid())
  userId     String
  activityId String

  status ProgressStatus @default(IN_PROGRESS)

  startedAt   DateTime?
  completedAt DateTime?

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity MissionActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, activityId])
  @@index([userId])
  @@index([activityId])
}

// =========================
// Logs
// =========================

model ActivityAnswerLog {
  id         String @id @default(cuid())
  userId     String
  activityId String

  // selectedChoiceId, selectedIds, orderedIds, matchPairs, userAnswer などを保存
  answer Json

  isCorrect Boolean?

  answeredAt DateTime @default(now())

  user     User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  activity MissionActivity @relation(fields: [activityId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([activityId])
}

// =========================
// Enums
// =========================

enum CourseDifficulty {
  EASY
  NORMAL
  HARD
}

enum FeedbackCondition {
  STANDARD
  PERSONALIZED
}

enum CourseExamFeedbackStatus {
  GENERATING
  COMPLETED
  FAILED
}

enum CourseExamFeedbackActionType {
  RETRY_COURSE_EXAM
  SOLVE_PRACTICE_PROBLEM
  CREATE_LEARNING_MEMO
  CREATE_QUESTION_POST
  CREATE_ERROR_HELP_POST
  CREATE_WORK_POST
  VIEW_BOARD_POSTS
  ANSWER_BOARD_POST
  REVIEW_KNOWLEDGE_CARDS
  VIEW_ACHIEVEMENTS
  SET_TARGET_ACHIEVEMENT
  USE_BADGE_TICKET
  VIEW_BADGE_COLLECTION
  SET_PROFILE_BADGE
  VIEW_PROFILE
  NO_APP_ACTION
}

enum MissionType {
  MAIN
  CHALLENGE
  COURSE_EXAM
}

enum CourseCategoryType {
  GAME
  ALGORITHM
  TOOL
  UI
  DATA
  SORT
  SEARCH
  GRAPH
  DATA_STRUCTURE
  DYNAMIC_PROGRAMMING
}

enum CreateThemeCategory {
  UI
  HTML_CSS
  JAVASCRIPT
  FORM
  DATA_DISPLAY
  API
  CRUD
  GAME
}

enum CreateWorkStatus {
  DRAFT
  COMPLETED
}

enum CreateWorkVisibility {
  PRIVATE
  SHARED
}

enum MissionActivityType {
  TUTORIAL
  VIEW
  CHOICE
  MATCH
  ORDERED_STEPS
  SELECT_FILL
  TRY_CODE
}

enum ProgressStatus {
  IN_PROGRESS
  COMPLETED
}

enum AchievementCategory {
  MISSION_COUNT
  MISSION_CLEAR
  MISSION_COMPLETE
  COURSE_EXAM
  LEARNING_ACTION
  COURSE_COMPLETE
  STREAK
}

enum AchievementConditionType {
  MISSION_COUNT
  SPECIFIC_MISSION_CLEAR
  COURSE_REQUIRED_MISSION_COMPLETE
  COURSE_ALL_MISSION_COMPLETE
  COURSE_EXAM_HARD_CLEAR
  ACTIVITY_COUNT
  COURSE_COMPLETE
  STREAK_DAYS
}

enum KnowledgeCardRarity {
  COMMON
  RARE
  EPIC
}

enum TechIconBadgeRarity {
  COMMON
  RARE
  EPIC
  LEGENDARY
}

enum BadgeTicketReason {
  MISSION_COMPLETE
  CHALLENGE_COMPLETE
  COURSE_COMPLETE
  ACHIEVEMENT_UNLOCK
  BADGE_GACHA
  CREATE_WORK_SAVE
  CREATE_WORK_REVIEW
}

enum QuestPostCategory {
  QUESTION
  ERROR_HELP
  WORK_SHARE
  CODE_SHARE
  MEMO
  REFERENCE
}

enum QuestPostStatus {
  OPEN
  RESOLVED
}

enum QuestPostVisibility {
  PUBLIC
}

enum QuestReactionType {
  LIKE
  HELPFUL
  SAVED_ME
}
